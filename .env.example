# Copy to .env for local development. Never commit .env.
# Development credentials match docker-compose.dev.yml and are NOT for production.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Runtime role (diary_app): used by the API. DML only, no schema changes.
DATABASE_URL=postgres://diary_app:diary_app_dev_password@127.0.0.1:5433/diary
DATABASE_POOL_MAX=10

# Owner role (diary_owner): used only by migrations (npm run db:migrate).
DATABASE_MIGRATION_URL=postgres://diary_owner:diary_dev_password@127.0.0.1:5433/diary

# Local PostgreSQL port on the host (docker-compose.dev.yml).
POSTGRES_HOST_PORT=5433
