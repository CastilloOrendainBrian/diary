# Copy to .env for local development. Never commit .env.
# Development credentials match docker-compose.dev.yml and are NOT for production.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Runtime role (diary_app): used by the API. DML only, no schema changes.
DATABASE_URL=postgres://diary_app:diary_app_dev_password@127.0.0.1:5433/diary
DATABASE_POOL_MAX=10

# Owner role (diary_owner): used only by migrations (npm run db:migrate).
DATABASE_MIGRATION_URL=postgres://diary_owner:diary_dev_password@127.0.0.1:5433/diary

# Local PostgreSQL port on the host (docker-compose.dev.yml).
POSTGRES_HOST_PORT=5433

# Authentication by emailed code (Phase 2)
# Generate with: openssl rand -base64 48   (required, at least 32 characters)
CODE_HMAC_SECRET=change-me-generate-with-openssl-rand-base64-48
PUBLIC_URL=http://localhost:5173

# Registration and codes
REGISTRATION_ENABLED=true
ALLOWED_EMAIL_DOMAINS=
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_REQUESTS_PER_15_MIN=3
AUTH_RATE_LIMIT_PER_MINUTE=10

# Sessions
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# Mail: Resend (transactional email).
# RESEND_API_KEY: API key with sending access (secret, never commit).
# MAIL_FROM: sender on a domain verified in Resend (SPF, DKIM, DMARC).
# Use MAIL_PROVIDER=console only for local work without a Resend key.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Diario <no-reply@your-verified-domain.com>
MAIL_REPLY_TO=

# Production stack (docker-compose.yml). Only these values are read from .env:
# PUBLIC_URL=https://diario.example.com      public origin (used for the Origin check)
# MAIL_FROM=Diario <noreply@your-verified-domain.com>
# NGINX_HOST_PORT=3004                       published on 127.0.0.1 only
# POSTGRES_HOST_PORT=5433                    published on 127.0.0.1 only
# BACKUP_UID / BACKUP_GID=1000               owner of ./backups (run: id -u / id -g)
# BACKUP_RETENTION_DAYS=14
# BACKUP_DIR=/var/backups/diary            where dumps are stored (default ./backups)
# Secrets live in ./secrets: run scripts/generate-secrets.sh, then paste the Resend key.
